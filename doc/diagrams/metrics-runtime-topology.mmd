%% Runtime topology of Application Metrics (pull model)
%% draw.io import:  Arrange panel > Insert > Advanced > Mermaid...  and paste.

flowchart LR
    subgraph net["Docker network: shipping_network"]
        subgraph order["order-01"]
            oa["app :8090"]
            om["metrics :9490"]
        end
        subgraph delivery["delivery-01"]
            da["app :8091"]
            dm["metrics :9491"]
        end
        subgraph gw["gateway-01"]
            ga["app :8080"]
            gm["metrics :9492"]
        end
        subgraph drone["drone-01"]
            dra["app :8092"]
            drm["metrics :9493"]
        end
        prom["prometheus-01 :9090\nscrape_interval 10s"]
    end

    prom -->|GET /metrics| om
    prom -->|GET /metrics| dm
    prom -->|GET /metrics| gm
    prom -->|GET /metrics| drm

    classDef metric fill:#fde2c8,stroke:#d1701a,color:#000;
    class om,dm,gm,drm,prom metric;

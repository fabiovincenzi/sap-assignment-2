        <mxCell id="e_proxy_del" value="REST" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="proxy" target="delivery">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_prom_obs" value="GET :9490/metrics" style="endArrow=block;html=1;fontSize=10;strokeColor=#D79B00;fontColor=#D79B00;fontStyle=1;" edge="1" parent="1" source="prom" target="obs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

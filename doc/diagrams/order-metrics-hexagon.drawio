        <mxCell id="e_svc_del" value="uses" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="svc" target="pDel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_svc_obs" value="notifies" style="endArrow=block;html=1;fontSize=10;strokeColor=#D79B00;fontColor=#D79B00;fontStyle=1;" edge="1" parent="1" source="svc" target="pObs">
          <mxGeometry relative="1" as="geometry" />

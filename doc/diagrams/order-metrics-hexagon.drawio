        <mxCell id="e_obs_impl" value="implements" style="endArrow=block;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#D79B00;" edge="1" parent="1" source="obs" target="pObs">
          <mxGeometry relative="1" as="geometry" />

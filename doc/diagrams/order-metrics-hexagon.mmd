%% Application Metrics integrated in the Hexagonal Architecture (Order Service)
%% Import in draw.io: Extras > Edit Diagram... is for mxGraph XML;
%% for this file use  Arrange panel > Insert > Advanced > Mermaid...  and paste.

flowchart LR
    %% ---------- external actors ----------
    client([HTTP client])
    delivery([delivery-service])
    prom[(Prometheus\nscrapes /metrics)]

    subgraph DRIVING["Driving / Inbound adapters (infrastructure)"]
        ctrl["OrderController #64;Adapter\nHTTP :8090  + /health"]
    end

    subgraph CORE["CORE  (technology-agnostic)"]
        direction TB
        subgraph APP["Application"]
            svc["OrderService #64;InBoundPort"]
            pRepo{{"OrderRepository\n#64;OutBoundPort"}}
            pDel{{"DeliveryServicePort\n#64;OutBoundPort"}}
            pObs{{"OrderServiceObserver\n#64;OutBoundPort"}}
        end
        subgraph DOM["Domain"]
            agg["Order #64;Aggregate\nOrderConfirmed / OrderCancelled #64;DomainEvent"]
        end
        svc --> agg
        svc -->|uses| pRepo
        svc -->|uses| pDel
        svc -->|notifies| pObs
    end

    subgraph DRIVEN["Driven / Outbound adapters (infrastructure)"]
        repo["InMemoryOrderRepository #64;Adapter"]
        proxy["DeliveryServiceProxy #64;Adapter"]
        obs["PrometheusOrderServiceObserver #64;Adapter\nCounter orders_placed_total\nHTTPServer :9490"]
    end

    %% ---------- wiring ----------
    client -->|POST /api/orders| ctrl
    ctrl -->|calls| svc

    repo -. implements .-> pRepo
    proxy -. implements .-> pDel
    obs  -. implements .-> pObs

    proxy -->|REST| delivery
    prom  -->|GET :9490/metrics| obs

    %% ---------- highlight the metrics path ----------
    classDef metric fill:#fde2c8,stroke:#d1701a,color:#000;
    classDef port fill:#eef,stroke:#557,color:#000;
    class obs,pObs,prom metric;
    class pRepo,pDel port;
